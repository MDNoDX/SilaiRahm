{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "DATABASE_URL=\"${DATABASE_URL_UNPOOLED:-$DATABASE_URL}\" python manage.py migrate --noinput && DATABASE_URL=\"${DATABASE_URL_UNPOOLED:-$DATABASE_URL}\" python manage.py createcachetable",
  "functions": {
    "config/wsgi.py": {
      "maxDuration": 60
    }
  },
  "crons": [
    {
      "path": "/cron/kunlik/?soat=00",
      "schedule": "0 0 * * *"
    },
    {
      "path": "/cron/kunlik/?soat=01",
