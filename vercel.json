      "schedule": "0 23 * * *"
    }
  ],
  "regions": [
    "fra1"
  ],
  "headers": [
    {
      "source": "/static/(.+)\\.([0-9a-f]{12})\\.(css|js|png|svg|webmanifest|jpg|ico)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ]
