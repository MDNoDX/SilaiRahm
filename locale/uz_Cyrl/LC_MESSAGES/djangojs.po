#: static/js/app.js:20
msgid "Are you sure you want to delete this?"
msgstr "Ростдан ҳам ўчирмоқчимисиз?"

#: static/js/app.js:38
msgid "Automatic"
msgstr "Автоматик"

#: static/js/app.js:38
msgid "Light"
msgstr "Ёруғ"

#: static/js/app.js:38
msgid "Dark"
msgstr "Қоронғи"

#: static/js/app.js:41
msgid "Colour theme"
msgstr "Ранг мавзуси"

#: static/js/app.js:130 static/js/assistant.js:68
msgid "Saving…"
msgstr "Сақланмоқда…"

#: static/js/app.js:165
msgid "Choose a file"
msgstr "Файл танлаш"

#: static/js/app.js:171
msgid "No file chosen"
msgstr "Файл танланмаган"

#: static/js/app.js:201
msgid "Remove"
msgstr "Олиб ташлаш"

#: static/js/app.js:274
msgid "Copied"
msgstr "Нусхаланди"

#: static/js/app.js:321
msgid "The photo is too large. The maximum size is %(size)s MB."
msgstr "Расм ҳажми жуда катта. Энг кўпи %(size)s МБ бўлиши мумкин."

#: static/js/app.js:365
msgid "Close"
msgstr "Ёпиш"

#: static/js/app.js:436 static/js/app.js:577
msgid "No results found."
msgstr "Қидирув натижаси топилмади."

#: static/js/app.js:647
msgid "On for this device"
msgstr "Бу қурилмада ёқилган"

#: static/js/app.js:648
msgid "Blocked in the browser settings"
msgstr "Браузер созламаларида блокланган"

#: static/js/app.js:648
msgid "Off for this device"
msgstr "Бу қурилмада ўчирилган"

#: static/js/app.js:715 static/js/app.js:795
msgid "The recording is too long: up to 4 MB (about 25 minutes of voice or 1 minute of video)."
msgstr "Ёзув жуда узун: 4 MB гача (тахминан 25 дақиқа овоз ёки 1 дақиқа видео)."

#: static/js/app.js:723
msgid "This browser cannot attach the recording. Choose a recorded file instead."
msgstr "Бу браузер ёзувни бириктира олмайди. Унинг ўрнига ёзиб олинган файлни танланг."

#: static/js/app.js:783
msgid "The camera could not be turned on. Allow access to the camera and the microphone in the browser."
msgstr "Камерани ёқиб бўлмади. Браузерда камера ва микрофонга рухсат беринг."

#: static/js/app.js:784 static/js/assistant.js:191
msgid "The microphone could not be turned on. Allow access to the microphone in the browser."
msgstr "Микрофонни ёқиб бўлмади. Браузерда микрофонга рухсат беринг."

#: static/js/app.js:811 static/js/assistant.js:174
msgid "Writing it down…"
msgstr "Матнга ёзилмоқда…"

#: static/js/app.js:823 static/js/assistant.js:96 static/js/assistant.js:184
msgid "Something went wrong. Please try again."
msgstr "Нимадир хато кетди. Қайтадан уриниб кўринг."

#: static/js/assistant.js:64
msgid "Add"
msgstr "Қўшиш"

#: static/js/assistant.js:65
msgid "No, thanks"
msgstr "Йўқ, раҳмат"

#: static/js/assistant.js:73
msgid "Open"
msgstr "Очиш"

#: static/js/assistant.js:74
msgid "Saved"
msgstr "Сақланди"

#: static/js/assistant.js:84
msgid "Not saved"
msgstr "Сақланмади"

#: static/js/assistant.js:98
msgid "No connection. Check the internet and try again."
msgstr "Алоқа йўқ. Интернетни текшириб, қайтадан уриниб кўринг."

#: static/js/assistant.js:122
msgid "Proposed"
msgstr "Таклиф қилинди"

#: static/js/tree.js:141
msgid "Family tree"
msgstr "Шажара"

#: static/js/tree.js:183
msgid "Hide brothers and sisters"
msgstr "Ака-ука ва опа-сингилларини яшириш"

#: static/js/tree.js:183
msgid "Show brothers and sisters"
msgstr "Ака-ука ва опа-сингилларини кўрсатиш"

#: static/js/tree.js:188
msgid "Hide children"
msgstr "Фарзандларини яшириш"

#: static/js/tree.js:188
msgid "Show children"
msgstr "Фарзандларини кўрсатиш"

#: static/js/tree.js:510
msgid "You"
msgstr "Сиз"

#: static/js/tree.js:595 static/js/tree.js:704
msgid "An error occurred."
msgstr "Хатолик юз берди."

#: static/js/tree.js:617
msgid "Could not load the family tree. Please try again."
msgstr "Шажарани юклаб бўлмади. Қайтадан уриниб кўринг."

#: static/js/tree.js:626
msgid "The family tree is empty."
msgstr "Шажара ҳали бўш."

#: static/js/tree.js:707
msgctxt "file name"
msgid "family-tree"
msgstr "шажара"
