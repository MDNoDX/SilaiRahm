#: static/js/app.js:20
msgid "Are you sure you want to delete this?"
msgstr "Rostdan ham oʻchirmoqchimisiz?"

#: static/js/app.js:38
msgid "Automatic"
msgstr "Avtomatik"

#: static/js/app.js:38
msgid "Light"
msgstr "Yorugʻ"

#: static/js/app.js:38
msgid "Dark"
msgstr "Qorongʻi"

#: static/js/app.js:41
msgid "Colour theme"
msgstr "Rang mavzusi"

#: static/js/app.js:130 static/js/assistant.js:71 static/js/assistant.js:250
msgid "Saving…"
msgstr "Saqlanmoqda…"

#: static/js/app.js:165
msgid "Choose a file"
msgstr "Fayl tanlash"

#: static/js/app.js:171
msgid "No file chosen"
msgstr "Fayl tanlanmagan"

#: static/js/app.js:201 static/js/assistant.js:220
msgid "Remove"
msgstr "Olib tashlash"

#: static/js/app.js:274
msgid "Copied"
msgstr "Nusxalandi"

#: static/js/app.js:321
msgid "The photo is too large. The maximum size is %(size)s MB."
msgstr "Rasm hajmi juda katta. Eng koʻpi %(size)s MB boʻlishi mumkin."

#: static/js/app.js:365
msgid "Close"
msgstr "Yopish"

#: static/js/app.js:436 static/js/app.js:577
msgid "No results found."
msgstr "Qidiruv natijasi topilmadi."

#: static/js/app.js:647
msgid "On for this device"
msgstr "Bu qurilmada yoqilgan"

#: static/js/app.js:648
msgid "Blocked in the browser settings"
msgstr "Brauzer sozlamalarida bloklangan"

#: static/js/app.js:648
msgid "Off for this device"
msgstr "Bu qurilmada oʻchirilgan"

#: static/js/app.js:715 static/js/app.js:795 static/js/assistant.js:200
msgid "The recording is too long: up to 4 MB (about 25 minutes of voice or 1 minute of video)."
msgstr "Yozuv juda uzun: 4 MB gacha (taxminan 25 daqiqa ovoz yoki 1 daqiqa video)."

#: static/js/app.js:723
msgid "This browser cannot attach the recording. Choose a recorded file instead."
msgstr "Bu brauzer yozuvni biriktira olmaydi. Uning oʻrniga yozib olingan faylni tanlang."

#: static/js/app.js:783
msgid "The camera could not be turned on. Allow access to the camera and the microphone in the browser."
msgstr "Kamerani yoqib boʻlmadi. Brauzerda kamera va mikrofonga ruxsat bering."

#: static/js/app.js:784 static/js/assistant.js:331
msgid "The microphone could not be turned on. Allow access to the microphone in the browser."
msgstr "Mikrofonni yoqib boʻlmadi. Brauzerda mikrofonga ruxsat bering."

#: static/js/app.js:811 static/js/assistant.js:281
msgid "Writing it down…"
msgstr "Matnga yozilmoqda…"

#: static/js/app.js:823 static/js/assistant.js:99 static/js/assistant.js:154
msgid "Something went wrong. Please try again."
msgstr "Nimadir xato ketdi. Qaytadan urinib koʻring."

#: static/js/assistant.js:66
msgid "Add"
msgstr "Qoʻshish"

#: static/js/assistant.js:68
msgid "No, thanks"
msgstr "Yoʻq, rahmat"

#: static/js/assistant.js:76 static/js/assistant.js:261
msgid "Open"
msgstr "Ochish"

#: static/js/assistant.js:77 static/js/assistant.js:275
msgid "Saved"
msgstr "Saqlandi"

#: static/js/assistant.js:87
msgid "Not saved"
msgstr "Saqlanmadi"

#: static/js/assistant.js:101 static/js/assistant.js:169 static/js/assistant.js:238
msgid "No connection. Check the internet and try again."
msgstr "Aloqa yoʻq. Internetni tekshirib, qaytadan urinib koʻring."

#: static/js/assistant.js:140
msgid "Proposed"
msgstr "Taklif qilindi"

#: static/js/assistant.js:219 static/js/assistant.js:285
msgid "Turn into text and send"
msgstr "Matnga aylantirib yuborish"

#: static/js/assistant.js:222
msgid "Title"
msgstr "Sarlavha"

#: static/js/assistant.js:223
msgid "For example: Grandfather tells about his childhood"
msgstr "Masalan: Bobom bolaligi haqida soʻzlaydi"

#: static/js/assistant.js:224
msgid "Also write it down as text"
msgstr "Matn qilib ham yozilsin"

#: static/js/assistant.js:225 static/js/assistant.js:254
msgid "Save as an event"
msgstr "Voqea sifatida saqlash"

#: static/js/assistant.js:244
msgid "Write a title for the recording."
msgstr "Yozuvga sarlavha yozing."

#: static/js/assistant.js:263
msgid "Edit"
msgstr "Tahrirlash"

#: static/js/tree.js:141
msgid "Family tree"
msgstr "Shajara"

#: static/js/tree.js:183
msgid "Hide brothers and sisters"
msgstr "Aka-uka va opa-singillarini yashirish"

#: static/js/tree.js:183
msgid "Show brothers and sisters"
msgstr "Aka-uka va opa-singillarini koʻrsatish"

#: static/js/tree.js:188
msgid "Hide children"
msgstr "Farzandlarini yashirish"

#: static/js/tree.js:188
msgid "Show children"
msgstr "Farzandlarini koʻrsatish"

#: static/js/tree.js:510
msgid "You"
msgstr "Siz"

#: static/js/tree.js:595 static/js/tree.js:704
msgid "An error occurred."
msgstr "Xatolik yuz berdi."

#: static/js/tree.js:617
msgid "Could not load the family tree. Please try again."
msgstr "Shajarani yuklab boʻlmadi. Qaytadan urinib koʻring."

#: static/js/tree.js:626
msgid "The family tree is empty."
msgstr "Shajara hali boʻsh."

