msgstr "Email orqali roʻyxatdan oʻtish hozircha ishlamaydi. Google orqali davom eting."

#: apps/accounts/views/auth.py:36
msgid "The code could not be sent to this address. Check it and try again."
msgstr "Bu manzilga kod yuborib boʻlmadi. Manzilni tekshirib, qaytadan urinib koʻring."

#: apps/accounts/views/auth.py:53
msgid "A new code has been sent."
msgstr "Yangi kod yuborildi."

#: apps/accounts/views/auth.py:55
msgid "Please wait a minute before asking for a new code."
msgstr "Yangi kod soʻrashdan oldin bir daqiqa kuting."

