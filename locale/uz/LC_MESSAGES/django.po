#: apps/accounts/signup.py:32
#, python-format
msgid "Your Silai Rahm code: %(code)s"
msgstr "Silai Rahm kodingiz: %(code)s"

#: apps/accounts/signup.py:33
#, python-format
msgid ""
"Hello, %(name)s!\n"
"\n"
"Your code to finish signing up on Silai Rahm: %(code)s\n"
"\n"
"It is valid for 15 minutes. If you did not sign up, ignore this email."
msgstr ""
"Assalomu alaykum, %(name)s!\n"
"\n"
"Silai Rahmda roʻyxatdan oʻtishni yakunlash uchun kodingiz: %(code)s\n"
"\n"
"Kod 15 daqiqa amal qiladi. Agar roʻyxatdan oʻtmagan boʻlsangiz, bu xatga eʼtibor bermang."

#: apps/accounts/signup.py:68
msgid "Start signing up again."
msgstr "Roʻyxatdan oʻtishni qaytadan boshlang."

#: apps/accounts/signup.py:70
msgid "The code has expired. Ask for a new one."
msgstr "Kodning muddati tugadi. Yangisini soʻrang."

#: apps/accounts/signup.py:72
msgid "Too many wrong codes. Ask for a new one."
msgstr "Notoʻgʻri kod koʻp marta kiritildi. Yangisini soʻrang."

#: apps/accounts/signup.py:76
msgid "The code is not right. Check the email and try again."
msgstr "Kod notoʻgʻri. Xatni tekshirib, qaytadan kiriting."

#: apps/accounts/signup.py:79
msgid "This username was taken in the meantime. Start signing up again."
msgstr "Bu orada bu foydalanuvchi nomini boshqa odam oldi. Roʻyxatdan oʻtishni qaytadan boshlang."

#: apps/accounts/views/auth.py:30 templates/accounts/auth/register.html:20
